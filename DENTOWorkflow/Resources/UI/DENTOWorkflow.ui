         <widget class="QCheckBox" name="crossViewNavigationCheckBox">
           <property name="toolTip"><string>Use Slicer's accurate native crosshair picking. Hold Shift while hovering over visible anatomy in 3D to move the crosshair and centre all linked slice views; slice-view crosshair movement remains linked in the other direction.</string></property>
           <property name="text"><string>Link 3D and slice locations (Shift-hover in 3D)</string></property>
           <property name="visible"><bool>false</bool></property>
          </widget>
         </item>
         <item row="3" column="0" colspan="2">
