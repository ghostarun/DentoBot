       <widget class="QLabel" name="templateModelingSafetyLabel">
        <property name="styleSheet">
         <string notr="true">color: #b36b00;</string>
        </property>
        <property name="text">
         <string>The visible support preview is derived research geometry only. It is not yet an undercut-corrected fitting surface, printable template, manufacturing approval, clinical validation, or authorization to drill.</string>
        </property>
