      <item>
       <layout class="QGridLayout" name="planningButtonGridLayout">
        <item row="0" column="0">
         <widget class="QPushButton" name="createTrajectoryButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
