       <widget class="QPushButton" name="createDraftTemplateSupportModelButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Create or explicitly update one draft model from the target and all checked support teeth. Source segmentation surfaces are not modified.</string>
        </property>
        <property name="text">
         <string>Create Draft Support Model</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="deleteDraftTemplateSupportModelButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Permanently remove only the selected DENTOBOT draft support-anatomy model after confirmation. The segmentation, target tooth, and checked support teeth are preserved.</string>
        </property>
        <property name="text">
         <string>Delete Draft Support Model...</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="templateSupportBoundaryButtonLayout">
        <item>
         <widget class="QPushButton" name="createTemplateSupportBoundaryButton">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Place one closed loop directly on the orange draft teeth near the intended gingival/cervical margin, then right-click to finish. The loop may address only a subset of the disconnected selected teeth; source anatomy is not modified.</string></property>
          <property name="text"><string>Create / Redraw Support Boundary</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="generateVisibleTemplateSupportModelButton">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Evaluate both boundary sides per tooth and retain the crown-side patch using the selected target trajectory direction. Disconnected mesh islands are diagnostics inside their source tooth, not additional teeth.</string></property>
          <property name="text"><string>Generate / Update Visible Support Preview</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QPushButton" name="deleteTemplateSupportSelectionButton">
        <property name="enabled"><bool>false</bool></property>
        <property name="toolTip"><string>Delete the DENTOBOT-owned visible support boundary and derived preview while preserving the segmentation and selected teeth.</string></property>
        <property name="text"><string>Delete Visible Support Selection...</string></property>
       </widget>
      </item>
