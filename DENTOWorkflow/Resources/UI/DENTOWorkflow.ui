      <item>
       <widget class="QGroupBox" name="planningViewControlsGroupBox">
        <property name="title"><string>Planning view</string></property>
        <property name="toolTip"><string>Viewport-only controls. They do not move the tooth, trajectory, segmentation, or target bounds.</string></property>
        <layout class="QGridLayout" name="planningViewControlsLayout">
         <item row="0" column="0">
          <widget class="QPushButton" name="focusPlanningTargetButton">
           <property name="enabled"><bool>false</bool></property>
           <property name="toolTip"><string>Show the selected target tooth, its matching pulp/root-canal mask when available, and only the selected Entry-to-Target trajectory. Other anatomy and workflow objects are hidden display-only.</string></property>
           <property name="text"><string>Show Trajectory Only</string></property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QPushButton" name="framePlanningTargetButton">
           <property name="enabled"><bool>false</bool></property>
