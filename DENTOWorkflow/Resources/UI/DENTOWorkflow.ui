   <item>
    <widget class="ctkCollapsibleButton" name="assistedTrajectoryCollapsibleButton">
     <property name="text">
      <string>Optional assisted trajectory initialization</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="assistedTrajectoryVerticalLayout">
      <item>
       <widget class="QLabel" name="assistedTrajectoryDescriptionLabel">
        <property name="text">
         <string>Alternative creation mode within Step 4A for one- or two-root teeth. Place only the crown Entry point(s); DENTOBOT estimates rootward Target point(s) from the selected complete tooth surface and creates the same normal Step 4A trajectory line nodes used by manual planning. The estimate is not a canal centreline and must be corrected in the trajectory MPR.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="assistedTrajectoryFormLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="assistedTrajectoryCountLabel">
          <property name="text">
           <string>Expected roots:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="assistedTrajectoryCountComboBox">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Choose the known procedure count. V1 supports exactly one or two trajectories and does not infer arbitrary root counts.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="assistedTrajectoryButtonsLayout">
        <item>
         <widget class="QPushButton" name="placeAssistedTrajectoryEntriesButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Place one crown Entry per requested trajectory. Existing trajectory nodes are never overwritten.</string>
          </property>
          <property name="text">
           <string>Place / Replace Crown Entries</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="generateAssistedTrajectoriesButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Estimate rootward targets from the authoritative target-tooth closed surface and create unlocked Entry-to-Target Markups lines for manual MPR verification.</string>
          </property>
          <property name="text">
           <string>Generate Assisted Trajectory Node(s)</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QPushButton" name="restoreAssistedTrajectoryFocusButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Restore the exact segment and target-bounds visibility that existed before assisted Step 4A entry placement.</string>
        </property>
        <property name="text">
         <string>Exit Target-Only Focus</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="assistedTrajectoryStatusLabel">
        <property name="styleSheet">
         <string notr="true">color: #b36b00;</string>
        </property>
        <property name="text">
         <string>Select a reviewed target tooth in Step 4A.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="assistedTrajectorySafetyLabel">
        <property name="styleSheet">
         <string notr="true">color: #b36b00;</string>
        </property>
        <property name="text">
         <string>Research initializer only. Surface shape cannot identify pulp/canal anatomy, perforation risk, or a clinically safe target.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
   </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="targetDockingCollapsibleButton">
     <property name="text">
      <string>Step 4C — Target-Frame Guide Rails and Robot Docks</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QVBoxLayout" name="targetDockingVerticalLayout">
      <item>
       <widget class="QLabel" name="targetDockingDescriptionLabel">
        <property name="text"><string>Generate four independent hollow docking/registration features around the target-tooth crown centroid. Each robot-facing top/opening lies exactly on the fitted target-crown occlusal plane; its adjustable depth proceeds crown-to-root. There is no central crown hub or radial spoke. Step 5B attaches each dock independently to the shell while protecting the trajectory-guide envelope. Dimensions are visible research parameters, not a finalized robot interface.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="targetDockingFormLayout">
        <item row="0" column="0"><widget class="QLabel" name="targetDockingTrajectorySummaryTitleLabel"><property name="text"><string>Approved trajectories:</string></property></widget></item>
        <item row="0" column="1"><widget class="QLabel" name="targetDockingTrajectorySummaryLabel"><property name="text"><string>--</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        <item row="1" column="0"><widget class="QLabel" name="targetDockingReferencePlaneLabel"><property name="text"><string>Target reference plane:</string></property></widget></item>
        <item row="1" column="1">
         <widget class="qMRMLNodeComboBox" name="targetDockingReferencePlaneSelector">
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsPlaneNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>targetDockingReferencePlane</string></property>
