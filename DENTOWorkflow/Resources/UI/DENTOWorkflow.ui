           <set>Qt::TextSelectableByMouse</set>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="templateSupportTeethTitleLabel">
          <property name="text">
           <string>Support teeth:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QListWidget" name="templateSupportTeethListWidget">
