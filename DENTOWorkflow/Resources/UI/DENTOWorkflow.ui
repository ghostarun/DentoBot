      <item>
       <widget class="QGroupBox" name="trajectoryVerificationGroupBox">
        <property name="title">
         <string>Trajectory Verification — Longitudinal Oblique MPR</string>
        </property>
        <layout class="QVBoxLayout" name="trajectoryVerificationVerticalLayout">
         <item>
          <widget class="QCheckBox" name="trajectoryVerificationEnabledCheckBox">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Align one available Slicer slice view through the existing Entry-to-Target axis and show the selected CBCT without creating another volume or trajectory.</string>
           </property>
           <property name="text">
            <string>Enable trajectory-aligned oblique view</string>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="trajectoryVerificationRotationLayout">
           <item>
            <widget class="QLabel" name="trajectoryVerificationRotationTitleLabel">
             <property name="text">
              <string>Rotation:</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QSlider" name="trajectoryVerificationRotationSlider">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Rotate the longitudinal slice plane around the Entry-to-Target axis. You can correct either point in this view: the slice stays fixed during the drag, then preserves the selected circumferential plane around the corrected trajectory.</string>
             </property>
             <property name="minimum">
              <number>-180</number>
             </property>
             <property name="maximum">
              <number>180</number>
             </property>
             <property name="singleStep">
              <number>1</number>
             </property>
             <property name="pageStep">
              <number>15</number>
             </property>
             <property name="value">
              <number>0</number>
             </property>
             <property name="tracking">
              <bool>true</bool>
             </property>
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="trajectoryVerificationRotationValueLabel">
             <property name="minimumSize">
              <size>
               <width>52</width>
               <height>0</height>
              </size>
             </property>
             <property name="text">
              <string>0°</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QPushButton" name="resetTrajectoryVerificationButton">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Return to the deterministic zero-angle longitudinal plane without moving Entry or Target.</string>
           </property>
           <property name="text">
            <string>Reset Orientation to 0°</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="trajectoryVerificationStatusLabel">
           <property name="styleSheet">
            <string notr="true">color: #666666;</string>
           </property>
           <property name="text">
            <string>Complete Entry and Target and select a CBCT to enable verification.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="planningStatusLabel">
        <property name="styleSheet">
         <string notr="true">color: #b36b00;</string>
        </property>
        <property name="text">
         <string>Select a dental segmentation before defining a target tooth.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="planningSafetyLabel">
        <property name="styleSheet">
         <string notr="true">color: #b36b00;</string>
        </property>
        <property name="text">
         <string>Draft research input only. Target selection and geometric length do not establish anatomical safety, clinical suitability, plan approval, or authorization to drill.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="templateModelingCollapsibleButton">
     <property name="text">
      <string>Step 5A — Support Teeth and Visible Support Surface</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="templateModelingVerticalLayout">
      <item>
       <widget class="QLabel" name="templateModelingDescriptionLabel">
        <property name="text">
         <string>Select the target/support teeth from the authoritative segmentation, then draw an editable closed boundary around only the clinically visible erupted support surfaces. Full crown-and-root anatomy remains available for planning but is not the template fitting surface.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
