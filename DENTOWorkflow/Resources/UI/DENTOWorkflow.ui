       <widget class="QLabel" name="templateSupportSurfaceStatusLabel">
        <property name="styleSheet"><string notr="true">color: #b36b00;</string></property>
        <property name="text"><string>Create the full support model, then place one closed loop directly on the orange teeth near the intended gingival/cervical margin and right-click to finish.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
