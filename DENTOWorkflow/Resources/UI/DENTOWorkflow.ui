   <item>
    <widget class="ctkCollapsibleButton" name="templateModelingCollapsibleButton">
     <property name="text">
      <string>Step 5A — Draft Template Support Anatomy</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="templateModelingVerticalLayout">
      <item>
       <widget class="QLabel" name="templateModelingDescriptionLabel">
        <property name="text">
         <string>Use the current target tooth and manually select any number of additional whole teeth. Create one traceable draft model containing unmodified copies of their closed surfaces.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="templateModelingFormLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="templateTargetToothTitleLabel">
