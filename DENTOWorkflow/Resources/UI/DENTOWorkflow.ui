      <item>
       <widget class="ctkCollapsibleButton" name="trajectoryVerificationGroupBox">
        <property name="text">
         <string>Trajectory Verification — Longitudinal Oblique MPR</string>
        </property>
        <property name="collapsed">
         <bool>true</bool>
        </property>
        <layout class="QVBoxLayout" name="trajectoryVerificationVerticalLayout">
         <item>
          <widget class="QCheckBox" name="trajectoryVerificationEnabledCheckBox">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Align one available Slicer slice view through the existing Entry-to-Target axis and show the selected CBCT without creating another volume or trajectory.</string>
           </property>
           <property name="text">
            <string>Enable trajectory-aligned oblique view</string>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="trajectoryVerificationRotationLayout">
           <item>
            <widget class="QLabel" name="trajectoryVerificationRotationTitleLabel">
             <property name="text">
              <string>Rotation:</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QSlider" name="trajectoryVerificationRotationSlider">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Rotate the longitudinal slice plane around the Entry-to-Target axis. Drag the thumb or hover/focus the slider and use the mouse wheel. You can correct either point in this view: the slice stays fixed during the drag, then preserves the selected circumferential plane around the corrected trajectory.</string>
             </property>
             <property name="focusPolicy"><enum>Qt::StrongFocus</enum></property>
             <property name="minimum">
              <number>-180</number>
             </property>
             <property name="maximum">
              <number>180</number>
             </property>
             <property name="singleStep">
              <number>1</number>
             </property>
             <property name="pageStep">
              <number>15</number>
             </property>
             <property name="value">
              <number>0</number>
             </property>
             <property name="tracking">
              <bool>true</bool>
             </property>
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="trajectoryVerificationRotationValueLabel">
             <property name="minimumSize">
              <size>
               <width>52</width>
               <height>0</height>
              </size>
             </property>
             <property name="text">
              <string>0°</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
         <widget class="QPushButton" name="resetTrajectoryVerificationButton">
           <property name="enabled">
            <bool>false</bool>
           </property>
           <property name="toolTip">
            <string>Return to the deterministic zero-angle longitudinal plane without moving Entry or Target.</string>
           </property>
           <property name="text">
            <string>Reset Orientation to 0°</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="trajectoryVerificationSmoothInterpolationCheckBox">
           <property name="checked"><bool>true</bool></property>
           <property name="toolTip"><string>Use Slicer's native linear scalar-volume interpolation for a smoother CBCT display while verification is enabled. This is display-only: it does not resample, copy, or modify the source CBCT.</string></property>
           <property name="text"><string>Smooth CBCT display (native linear interpolation)</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="trajectoryVerificationStatusLabel">
           <property name="styleSheet">
            <string notr="true">color: #666666;</string>
           </property>
           <property name="text">
            <string>Complete Entry and Target and select a CBCT to enable verification.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
