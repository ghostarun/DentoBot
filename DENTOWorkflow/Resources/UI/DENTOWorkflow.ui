   <item>
    <widget class="ctkCollapsibleButton" name="templateFinalizationCollapsibleButton">
     <property name="text">
      <string>Step 5C — Final Verification and One-STL Export</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="templateFinalizationVerticalLayout">
      <item>
       <widget class="QLabel" name="finalVerificationDescriptionLabel">
        <property name="text"><string>Verify the current unified Step 5B template, including patient-contact shell, trajectory guide hole(s), and the Step 4C four-dock rail assembly. Export writes one atomic binary STL only when verification is PASS or WARNING.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="finalVerificationFormLayout">
        <item row="0" column="0"><widget class="QLabel" name="finalVerificationModelLabel"><property name="text"><string>Final unified template:</string></property></widget></item>
        <item row="0" column="1">
         <widget class="qMRMLNodeComboBox" name="finalVerificationModelSelector">
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QGridLayout" name="finalVerificationButtonLayout">
        <item row="0" column="0"><widget class="QPushButton" name="verifyFinalTemplateButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Run Final Geometry Verification</string></property></widget></item>
        <item row="0" column="1"><widget class="QPushButton" name="showFinalTemplateButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Show / Frame Final Template</string></property></widget></item>
        <item row="1" column="0" colspan="2"><widget class="QPushButton" name="exportFinalTemplateButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Export One Verified Template STL...</string></property></widget></item>
       </layout>
      </item>
      <item>
       <widget class="QTreeWidget" name="finalVerificationTreeWidget">
        <property name="minimumSize"><size><width>0</width><height>180</height></size></property>
        <property name="rootIsDecorated"><bool>false</bool></property>
        <property name="alternatingRowColors"><bool>true</bool></property>
        <property name="columnCount"><number>3</number></property>
        <column><property name="text"><string>Result</string></property></column>
        <column><property name="text"><string>Check</string></property></column>
        <column><property name="text"><string>Details</string></property></column>
       </widget>
      </item>
      <item><widget class="QLabel" name="finalVerificationStatusLabel"><property name="text"><string>Generate the integrated Step 5B unified template first.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #b36b00;</string></property></widget></item>
      <item><widget class="QLabel" name="finalVerificationSafetyLabel"><property name="text"><string>Verification checks computational geometry and provenance only. PASS does not establish clinical fit, sterilization suitability, mechanical strength, registration accuracy, or authorization to drill.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #b36b00;</string></property></widget></item>
      <item>
       <widget class="QLabel" name="templateFinalizationDescriptionLabel">
        <property name="text">
         <string>Preserve the raw Step 5B shell, then create a separate finalized shell with Slicer's Dynamic Modeler. Use a horizontal plane for the simple workflow or an adjustable closed curve for an uneven cervical/gingival margin.</string>
        </property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="templateFinalizationLineageLabel">
        <property name="minimumSize"><size><width>0</width><height>28</height></size></property>
        <property name="toolTip"><string>Step 5C inputs and outputs inherit the authoritative Step 4A target-tooth color through their Step 5B source-shell reference.</string></property>
        <property name="styleSheet"><string notr="true">QLabel { color: #555555; background-color: #eeeeee; border-left: 8px solid #999999; border-radius: 3px; padding: 5px 8px; }</string></property>
        <property name="text"><string>Inherited lineage: waiting for a current Step 5B shell.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="templateFinalizationFormLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="templateFinalizationSourceLabel"><property name="text"><string>Raw source shell:</string></property></widget>
        </item>
        <item row="0" column="1">
         <widget class="QLabel" name="templateFinalizationSourceValueLabel"><property name="text"><string>--</string></property><property name="wordWrap"><bool>true</bool></property></widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="templateFinalizationModeLabel"><property name="text"><string>Trim method:</string></property></widget>
        </item>
        <item row="1" column="1">
         <widget class="QComboBox" name="templateFinalizationModeComboBox">
          <item><property name="text"><string>Simple horizontal plane cut</string></property></item>
          <item><property name="text"><string>Adjustable closed-curve cut</string></property></item>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="templateFinalizationKeepRegionLabel"><property name="text"><string>Keep:</string></property></widget>
        </item>
        <item row="2" column="1">
         <widget class="QComboBox" name="templateFinalizationKeepRegionComboBox"/>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="templateTrimPlaneLabel"><property name="text"><string>Horizontal plane:</string></property></widget>
        </item>
        <item row="3" column="1">
         <widget class="qMRMLNodeComboBox" name="templateTrimPlaneSelector">
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsPlaneNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>templateTrimPlane</string></property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="templateTrimCurveLabel"><property name="text"><string>Closed margin curve:</string></property></widget>
        </item>
        <item row="4" column="1">
         <widget class="qMRMLNodeComboBox" name="templateTrimCurveSelector">
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsClosedCurveNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>templateTrimCurve</string></property>
         </widget>
        </item>
        <item row="5" column="0">
         <widget class="QLabel" name="finalizedTemplateShellModelLabel"><property name="text"><string>Finalized shell:</string></property></widget>
        </item>
        <item row="5" column="1">
         <widget class="qMRMLNodeComboBox" name="finalizedTemplateShellModelSelector">
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>finalizedTemplateShellModel</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="templateFinalizationCameraFrameLabel">
        <property name="styleSheet"><string notr="true">QLabel { color: #24557a; background-color: #eaf4fb; border: 1px solid #9bc5e1; border-radius: 3px; padding: 5px 8px; }</string></property>
        <property name="text"><string>ROI frame: +X right • +Z up • looking along +Y at yaw 0°</string></property>
        <property name="toolTip"><string>Isolation uses the locked Step 5B automatic ROI as a traditional XYZ frame. Yaw is rotation about ROI +Z; pitch and roll are zero in the default orbit.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="templateFinalizationViewLockedCheckBox">
        <property name="checked"><bool>true</bool></property>
        <property name="text"><string>Lock X/Y/Z translation, pitch, and roll (allow yaw + zoom)</string></property>
        <property name="toolTip"><string>Keep the ROI centered and the camera level while permitting 360-degree yaw around ROI +Z and interactive zoom. Uncheck for a fully free camera; the trim plane remains ROI-horizontal.</string></property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="templateFinalizationYawLockedCheckBox">
        <property name="checked"><bool>false</bool></property>
        <property name="text"><string>Lock yaw too (keep orientation fixed; zoom remains enabled)</string></property>
        <property name="toolTip"><string>Freeze the current yaw angle as well as translation, pitch, and roll while retaining interactive zoom. Enabling this also enables the non-yaw lock.</string></property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="templateFinalizationPreparationButtonLayout">
        <item><widget class="QPushButton" name="continueTemplateFinalizationButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Isolate Shell in ROI-Aligned 3D View</string></property><property name="toolTip"><string>Temporarily switch to one 3D view, hide unrelated nodes, initially fit the Step 5B ROI top-to-bottom, and start at yaw 0 degrees. Mouse-wheel zoom remains enabled.</string></property></widget></item>
        <item><widget class="QPushButton" name="restoreTemplateFinalizationViewButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Exit Isolation / Restore 2D + 3D</string></property><property name="toolTip"><string>Restore the previous Slicer layout, camera, crosshair, and node visibility for deliberate 2D verification.</string></property></widget></item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="templateFinalizationEditButtonLayout">
        <item><widget class="QPushButton" name="createTemplateTrimPlaneButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Pick ROI-Z Cut Height</string></property><property name="toolTip"><string>Click once to choose only the cut height along ROI Z. The plane is hard-constrained parallel to the locked ROI top/bottom faces; drag its single origin point vertically for fine adjustment.</string></property></widget></item>
        <item><widget class="QPushButton" name="placeTemplateTrimCurveButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Create / Place Closed Margin Curve</string></property><property name="toolTip"><string>Place at least three points on the visible shell. Double-click or right-click to finish, then drag the control points to refine the margin.</string></property></widget></item>
       </layout>
      </item>
      <item>
       <layout class="QGridLayout" name="templateFinalizationActionButtonLayout">
        <item row="0" column="0"><widget class="QPushButton" name="applyTemplateFinalizationButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Preview / Apply Trim</string></property></widget></item>
        <item row="0" column="1"><widget class="QPushButton" name="openDynamicModelerButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Open Dynamic Modeler...</string></property><property name="toolTip"><string>Open Slicer's expert Dynamic Modeler interface with the DENTOBOT cut node available for further inspection.</string></property></widget></item>
        <item row="1" column="0"><widget class="QPushButton" name="deleteTemplateFinalizationButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Delete Step 5C Edit...</string></property></widget></item>
        <item row="1" column="1"><widget class="QPushButton" name="exportResearchTemplateButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Export Final Shell + Sleeve STL...</string></property></widget></item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="templateFinalizationStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>Generate a current Step 5B shell and sleeve first.</string></property><property name="wordWrap"><bool>true</bool></property></widget>
      </item>
      <item>
       <widget class="QLabel" name="templateFinalizationSafetyLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>Research-only manual margin selection. The default plane position has no anatomical or clinical meaning. A dentist must verify orientation, retained side, fit, wall integrity, and fabrication suitability before any downstream use.</string></property><property name="wordWrap"><bool>true</bool></property></widget>
      </item>
     </layout>
   </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="robotPlacementCollapsibleButton">
     <property name="text"><string>Step 6 — Robot Placement and Manual Workspace Test</string></property>
     <property name="collapsed"><bool>true</bool></property>
     <layout class="QVBoxLayout" name="robotPlacementVerticalLayout">
      <item>
<widget class="QLabel" name="robotPlacementDescriptionLabel">
        <property name="text"><string>Choose a scene (case package or draft phantom), connect the simulation robot, place and lock the base, set task limits, then plan and preview. Hardware motion, MoveIt execution, and clinical safety validation are not authorized here.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
<widget class="QGroupBox" name="step6PlanningContextGroupBox">
        <property name="title"><string>6.0 — Choose Scene</string></property>
        <layout class="QVBoxLayout" name="step6PlanningContextVerticalLayout">
         <item><widget class="QLabel" name="step6PlanningContextDescriptionLabel"><property name="text"><string>Pick one scene. Import the Steps 0–5 case package to bring the CBCT, trajectory, docks, and template into view, or load the draft phantom for testing. These two scenes are mutually exclusive.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><widget class="QPushButton" name="importStep6PlanningContextButton"><property name="text"><string>Import Planning Package for Step 6</string></property></widget></item>
         <item><widget class="QLabel" name="step6PlanningContextStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>Planning package not imported.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
                 <item>
<widget class="QGroupBox" name="draftOpenMouthPhantomGroupBox">
        <property name="title"><string>Alternate scene — draft open-mouth phantom</string></property>
        <layout class="QVBoxLayout" name="draftOpenMouthPhantomVerticalLayout">
         <item><widget class="QLabel" name="draftOpenMouthDescriptionLabel"><property name="text"><string>Load the generic BodyParts3D skull/maxilla/mandible once (duplicate phantom or robot sets are rejected). The phantom is relocated near the Step 6 research workspace origin so it appears beside the robot. Place four approximate landmarks one at a time, then the mandible rotates about the TMJ hinge until the measured incisor gap is approximately 40 mm. This is not clinical jaw simulation.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item>
          <layout class="QFormLayout" name="draftOpenMouthNodeFormLayout">
           <item row="0" column="0"><widget class="QLabel" name="draftPhantomSkullLabel"><property name="text"><string>Fixed skull:</string></property></widget></item>
           <item row="0" column="1"><widget class="qMRMLNodeComboBox" name="draftPhantomSkullSelector"><property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property><property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property><property name="SlicerParameterName" stdset="0"><string>draftPhantomSkullModel</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="draftPhantomMandibleLabel"><property name="text"><string>Movable mandible:</string></property></widget></item>
           <item row="1" column="1"><widget class="qMRMLNodeComboBox" name="draftPhantomMandibleSelector"><property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property><property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property><property name="SlicerParameterName" stdset="0"><string>draftPhantomMandibleModel</string></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="draftJawLandmarksLabel"><property name="text"><string>Four landmarks:</string></property></widget></item>
           <item row="2" column="1"><widget class="qMRMLNodeComboBox" name="draftJawLandmarksSelector"><property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsFiducialNode</string></stringlist></property><property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property><property name="SlicerParameterName" stdset="0"><string>draftJawLandmarks</string></property></widget></item>
           <item row="3" column="0"><widget class="QLabel" name="draftJawTargetGapLabel"><property name="text"><string>Target incisor gap:</string></property></widget></item>
           <item row="3" column="1"><widget class="QDoubleSpinBox" name="draftJawTargetGapSpinBox"><property name="decimals"><number>1</number></property><property name="minimum"><double>20.000000</double></property><property name="maximum"><double>60.000000</double></property><property name="singleStep"><double>1.000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>40.000000</double></property><property name="SlicerParameterName" stdset="0"><string>draftJawTargetGapMm</string></property></widget></item>
          </layout>
         </item>
         <item>
          <layout class="QGridLayout" name="draftOpenMouthButtonLayout">
           <item row="0" column="0"><widget class="QPushButton" name="loadDraftPhantomButton"><property name="text"><string>Load Draft Skull + Jaw</string></property></widget></item>
           <item row="0" column="1"><widget class="QPushButton" name="createDraftJawLandmarksButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Place first landmark (Left TMJ)</string></property></widget></item>
           <item row="1" column="0"><widget class="QPushButton" name="clearDraftJawLandmarksButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Clear Landmarks</string></property></widget></item>
           <item row="1" column="1"><widget class="QPushButton" name="applyDraftJawOpeningButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Set Approx. 40 mm Opening</string></property></widget></item>
           <item row="2" column="0"><widget class="QPushButton" name="resetDraftJawButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Reset Jaw Closed</string></property></widget></item>
           <item row="2" column="1"><widget class="QPushButton" name="deleteDraftPhantomButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Delete Draft Phantom</string></property></widget></item>
          </layout>
         </item>
         <item><widget class="QLabel" name="draftOpenMouthStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>Load the local generic phantom to begin.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout>
       </widget>
         </item>
      </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="step6MountLockGroupBox">
        <property name="title"><string>6.1 — Load ROS Robot, Place, and Lock</string></property>
        <layout class="QVBoxLayout" name="step6MountLockVerticalLayout">
         <item><widget class="QLabel" name="step6MountLockDescriptionLabel"><property name="text"><string>After a scene is chosen, load the robot from ROS into the viewport. Then create/snap/nudge the mount plane and lock the base. Placement is blocked until a robot is in the scene. Unlock to adjust again.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><widget class="QGroupBox" name="ros2MotionControlGroupBox">
        <property name="title"><string>Load robot from ROS (SlicerROS2)</string></property>
        <layout class="QVBoxLayout" name="ros2MotionControlVerticalLayout">
         <item><widget class="QLabel" name="ros2MotionControlDescriptionLabel"><property name="text"><string>The DENTOBOT launcher owns a simulation-only ROS 2 + MoveIt stack. Manual joint requests are interpolated and accepted only when MoveIt reports valid bounds, no mesh collision, and at least 5 mm self/world clearance. Locking the base refreshes the head/case collision surfaces. Cartesian IK and planning use the URDF/SRDF chain and provisional TCP; no hand-written kinematic equations are used. Execution and hardware interfaces are disabled.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item>
          <layout class="QGridLayout" name="ros2MotionControlButtonLayout">
           <item row="0" column="0"><widget class="QPushButton" name="connectRos2MotionButton"><property name="text"><string>Connect ROS + MoveIt (Simulation)</string></property><property name="toolTip"><string>Connect to the stack already started by launch-dentoworkflow.bash, load the URDF through SlicerROS2, align base_link to the Step 6 base transform, send manual candidates through the collision guard to the sole simulated /joint_states source, and enable plan-only MoveIt.</string></property></widget></item>
           <item row="0" column="1"><widget class="QPushButton" name="disconnectRos2MotionButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Disconnect ROS 2 Robot</string></property></widget></item>
          </layout>
         </item>
         <item><widget class="QLabel" name="ros2MotionControlStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>ROS 2 stack not connected.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout>
       </widget></item>
         <item><layout class="QFormLayout" name="robotPlacementNodeFormLayout">
        <item row="0" column="0"><widget class="QLabel" name="robotBaseTransformLabel"><property name="text"><string>Robot base:</string></property></widget></item>
        <item row="0" column="1">
         <widget class="qMRMLNodeComboBox" name="robotBaseTransformSelector">
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLLinearTransformNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>robotBaseTransform</string></property>
         </widget>
        </item>
        <item row="1" column="0"><widget class="QLabel" name="robotMountPlaneLabel"><property name="text"><string>Mount plane:</string></property></widget></item>
        <item row="1" column="1">
         <widget class="qMRMLNodeComboBox" name="robotMountPlaneSelector">
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsPlaneNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>robotMountPlane</string></property>
         </widget>
        </item>
       </layout></item>
         <item>
          <layout class="QGridLayout" name="robotPlacementPrimaryButtonLayout">
           <item row="0" column="0"><widget class="QPushButton" name="createRobotMountPlaneButton"><property name="text"><string>Create / Reset Mount Plane</string></property><property name="toolTip"><string>Create an editable 120 mm plane at the current robot base, or reset the selected plane there. Drag its cyan translation and rotation handles in a 3D view.</string></property></widget></item>
           <item row="0" column="1"><widget class="QPushButton" name="flipRobotMountPlaneButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Flip Plane Normal</string></property></widget></item>
           <item row="1" column="0" colspan="2"><widget class="QPushButton" name="snapRobotBaseToPlaneButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Snap Base to Mount Plane</string></property><property name="toolTip"><string>Set the robot base origin and orientation to the plane. Scale and shear are removed; the plane normal becomes base +Z.</string></property></widget></item>
          </layout>
         </item>
         <item><widget class="QGroupBox" name="robotFinePlacementGroupBox">
        <property name="title"><string>Fine Base Placement (local axes)</string></property>
        <layout class="QVBoxLayout" name="robotFinePlacementVerticalLayout">
         <item>
          <layout class="QFormLayout" name="robotNudgeStepFormLayout">
           <item row="0" column="0"><widget class="QLabel" name="robotTranslationStepLabel"><property name="text"><string>Translation step:</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="robotTranslationStepSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.050000</double></property><property name="maximum"><double>20.000000</double></property><property name="singleStep"><double>0.500000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>1.000000</double></property><property name="SlicerParameterName" stdset="0"><string>robotTranslationStepMm</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="robotRotationStepLabel"><property name="text"><string>Rotation step:</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="robotRotationStepSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.050000</double></property><property name="maximum"><double>20.000000</double></property><property name="singleStep"><double>0.500000</double></property><property name="suffix"><string>°</string></property><property name="value"><double>1.000000</double></property><property name="SlicerParameterName" stdset="0"><string>robotRotationStepDeg</string></property></widget></item>
          </layout>
         </item>
         <item>
          <layout class="QGridLayout" name="robotTranslationNudgeButtonLayout">
           <item row="0" column="0"><widget class="QPushButton" name="robotXMinusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>X−</string></property></widget></item>
           <item row="0" column="1"><widget class="QPushButton" name="robotXPlusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>X+</string></property></widget></item>
           <item row="0" column="2"><widget class="QPushButton" name="robotYMinusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Y−</string></property></widget></item>
           <item row="0" column="3"><widget class="QPushButton" name="robotYPlusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Y+</string></property></widget></item>
           <item row="0" column="4"><widget class="QPushButton" name="robotZMinusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Z−</string></property></widget></item>
           <item row="0" column="5"><widget class="QPushButton" name="robotZPlusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Z+</string></property></widget></item>
           <item row="1" column="0"><widget class="QPushButton" name="robotRxMinusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Rx−</string></property></widget></item>
           <item row="1" column="1"><widget class="QPushButton" name="robotRxPlusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Rx+</string></property></widget></item>
           <item row="1" column="2"><widget class="QPushButton" name="robotRyMinusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Ry−</string></property></widget></item>
           <item row="1" column="3"><widget class="QPushButton" name="robotRyPlusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Ry+</string></property></widget></item>
           <item row="1" column="4"><widget class="QPushButton" name="robotRzMinusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Rz−</string></property></widget></item>
           <item row="1" column="5"><widget class="QPushButton" name="robotRzPlusButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Rz+</string></property></widget></item>
          </layout>
         </item>
         <item><widget class="QCheckBox" name="robotKeyboardNudgeCheckBox"><property name="enabled"><bool>false</bool></property><property name="text"><string>Enable keyboard nudge while Step 6 is active</string></property><property name="toolTip"><string>Arrows move local X/Y; Page Up/Down moves local Z; Shift+Left/Right rotates local Z; Shift+Up/Down rotates local X. Shortcuts are disabled outside Step 6 and while editing a text or number field.</string></property><property name="SlicerParameterName" stdset="0"><string>robotKeyboardNudgeEnabled</string></property></widget></item>
         <item>
          <layout class="QHBoxLayout" name="robotResetDeleteButtonLayout">
           <item><widget class="QPushButton" name="resetRobotBaseButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Reset Base to World</string></property></widget></item>
           <item><widget class="QPushButton" name="deleteRobotSetupButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Delete Robot Setup…</string></property></widget></item>
          </layout>
         </item>
        </layout>
       </widget></item>
         <item>
          <layout class="QHBoxLayout" name="step6MountLockButtonLayout">
<item><widget class="QPushButton" name="lockRobotBaseMountButton"><property name="text"><string>Lock Base Mount</string></property></widget></item>
           <item><widget class="QPushButton" name="unlockRobotBaseMountButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Unlock Base Mount</string></property></widget></item>
          
          </layout>
         </item>
         <item><widget class="QLabel" name="step6MountLockStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>Base mount is unlocked.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item>
          <widget class="QGroupBox" name="step6FallbackRobotGroupBox">
           <property name="title"><string>Fallback if ROS is unavailable</string></property>
           <property name="flat"><bool>true</bool></property>
           <layout class="QHBoxLayout" name="step6FallbackRobotHorizontalLayout">
            <item><widget class="QPushButton" name="loadRobotModelButton"><property name="text"><string>Load / Refresh Robot</string></property><property name="toolTip"><string>Load or reuse all seven STL link models and apply the tracked URDF joint chain at the current joint values.</string></property></widget></item>
            <item><widget class="QPushButton" name="frameRobotButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Frame Scene + Robot (fallback)</string></property><property name="toolTip"><string>Centre the 3D views on the combined robot and draft phantom bounds.</string></property></widget></item>
           </layout>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
<widget class="QGroupBox" name="step6TaskJointLimitsGroupBox">
        <property name="title"><string>6.2 — Task Joint Limits and Manual Pose</string></property>
        <layout class="QGridLayout" name="step6TaskJointLimitsGridLayout">
         <item row="0" column="0" colspan="4"><widget class="QLabel" name="step6TaskJointLimitsDescriptionLabel"><property name="text"><string>Each joint is one row: task min, current pose, and task max. Limits are clamped to the mechanical URDF envelope. Changing min or max updates the value range immediately. Apply still re-clamps all six rows; Reset restores URDF limits.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item row="1" column="1"><widget class="QLabel" name="step6JointMinHeaderLabel"><property name="text"><string>Min</string></property></widget></item>
         <item row="1" column="2"><widget class="QLabel" name="step6JointValueHeaderLabel"><property name="text"><string>Value</string></property></widget></item>
         <item row="1" column="3"><widget class="QLabel" name="step6JointMaxHeaderLabel"><property name="text"><string>Max</string></property></widget></item>
         <item row="2" column="0"><widget class="QLabel" name="robotJoint1Label"><property name="text"><string>J1 revolute (deg):</string></property></widget></item>
         <item row="2" column="1"><widget class="QDoubleSpinBox" name="robotJoint1TaskMinSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint1TaskMinDeg</string></property></widget></item>
         <item row="2" column="2"><widget class="QDoubleSpinBox" name="robotJoint1SpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-25.380000</double></property><property name="maximum"><double>334.620000</double></property><property name="singleStep"><double>1.000000</double></property><property name="suffix"><string>°</string></property><property name="SlicerParameterName" stdset="0"><string>robotJoint1Deg</string></property></widget></item>
         <item row="2" column="3"><widget class="QDoubleSpinBox" name="robotJoint1TaskMaxSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint1TaskMaxDeg</string></property></widget></item>
         <item row="3" column="0"><widget class="QLabel" name="robotJoint2Label"><property name="text"><string>J2 prismatic (mm):</string></property></widget></item>
         <item row="3" column="1"><widget class="QDoubleSpinBox" name="robotJoint2TaskMinSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>200.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint2TaskMinMm</string></property></widget></item>
         <item row="3" column="2"><widget class="QDoubleSpinBox" name="robotJoint2SpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>80.000000</double></property><property name="singleStep"><double>1.000000</double></property><property name="suffix"><string> mm</string></property><property name="SlicerParameterName" stdset="0"><string>robotJoint2Mm</string></property></widget></item>
         <item row="3" column="3"><widget class="QDoubleSpinBox" name="robotJoint2TaskMaxSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>200.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint2TaskMaxMm</string></property></widget></item>
         <item row="4" column="0"><widget class="QLabel" name="robotJoint3Label"><property name="text"><string>J3 revolute (deg):</string></property></widget></item>
         <item row="4" column="1"><widget class="QDoubleSpinBox" name="robotJoint3TaskMinSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint3TaskMinDeg</string></property></widget></item>
         <item row="4" column="2"><widget class="QDoubleSpinBox" name="robotJoint3SpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-62.460000</double></property><property name="maximum"><double>297.540000</double></property><property name="singleStep"><double>1.000000</double></property><property name="suffix"><string>°</string></property><property name="SlicerParameterName" stdset="0"><string>robotJoint3Deg</string></property></widget></item>
         <item row="4" column="3"><widget class="QDoubleSpinBox" name="robotJoint3TaskMaxSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint3TaskMaxDeg</string></property></widget></item>
         <item row="5" column="0"><widget class="QLabel" name="robotJoint4Label"><property name="text"><string>J4 prismatic reversed (mm):</string></property></widget></item>
         <item row="5" column="1"><widget class="QDoubleSpinBox" name="robotJoint4TaskMinSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>200.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint4TaskMinMm</string></property></widget></item>
         <item row="5" column="2"><widget class="QDoubleSpinBox" name="robotJoint4SpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>75.000000</double></property><property name="singleStep"><double>1.000000</double></property><property name="suffix"><string> mm</string></property><property name="SlicerParameterName" stdset="0"><string>robotJoint4Mm</string></property></widget></item>
         <item row="5" column="3"><widget class="QDoubleSpinBox" name="robotJoint4TaskMaxSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>200.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint4TaskMaxMm</string></property></widget></item>
         <item row="6" column="0"><widget class="QLabel" name="robotJoint5Label"><property name="text"><string>J5 revolute (deg):</string></property></widget></item>
         <item row="6" column="1"><widget class="QDoubleSpinBox" name="robotJoint5TaskMinSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint5TaskMinDeg</string></property></widget></item>
         <item row="6" column="2"><widget class="QDoubleSpinBox" name="robotJoint5SpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-1.080000</double></property><property name="maximum"><double>358.920000</double></property><property name="singleStep"><double>1.000000</double></property><property name="suffix"><string>°</string></property><property name="SlicerParameterName" stdset="0"><string>robotJoint5Deg</string></property></widget></item>
         <item row="6" column="3"><widget class="QDoubleSpinBox" name="robotJoint5TaskMaxSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint5TaskMaxDeg</string></property></widget></item>
         <item row="7" column="0"><widget class="QLabel" name="robotJoint6Label"><property name="text"><string>J6 spindle (deg):</string></property></widget></item>
         <item row="7" column="1"><widget class="QDoubleSpinBox" name="robotJoint6TaskMinSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint6TaskMinDeg</string></property></widget></item>
         <item row="7" column="2"><widget class="QDoubleSpinBox" name="robotJoint6SpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.000000</double></property><property name="maximum"><double>360.000000</double></property><property name="singleStep"><double>1.000000</double></property><property name="suffix"><string>°</string></property><property name="SlicerParameterName" stdset="0"><string>robotJoint6Deg</string></property></widget></item>
         <item row="7" column="3"><widget class="QDoubleSpinBox" name="robotJoint6TaskMaxSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>-360.0</double></property><property name="maximum"><double>360.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotJoint6TaskMaxDeg</string></property></widget></item>
         <item row="8" column="0" colspan="4"><layout class="QHBoxLayout" name="step6TaskJointLimitsButtonLayout"><item><widget class="QPushButton" name="applyTaskJointLimitsButton"><property name="text"><string>Apply Task Limits to Controls</string></property></widget></item><item><widget class="QPushButton" name="resetTaskJointLimitsButton"><property name="text"><string>Reset to URDF Limits</string></property></widget></item><item><widget class="QPushButton" name="resetRobotJointsButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Reset All Joints to Selected Zero</string></property></widget></item></layout></item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="step6WorkspaceGroupBox">
        <property name="title"><string>6.3 — Draft TCP Workspace Explorer</string></property>
        <layout class="QVBoxLayout" name="step6WorkspaceVerticalLayout">
         <item><widget class="QLabel" name="robotWorkspaceDescriptionLabel"><property name="text"><string>Generate a deterministic joint-space reach cloud for the provisional dentobot_tool_tcp. A six-dimensional Halton sequence is mapped into the selected task limits, evaluated by URDF forward kinematics, then filtered by the draft 5 mm non-adjacent-link AABB guard and provisional TCP-to-environment point clearance. Two documented persistent CAD-AABB false-positive pairs are excluded; MoveIt/FCL remains authoritative. This is not repeated IK, exact mesh collision, swept-volume, or clinical workspace validation.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><layout class="QFormLayout" name="robotWorkspaceFormLayout">
          <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Joint samples:</string></property></widget></item>
          <item row="0" column="1"><widget class="QSpinBox" name="robotWorkspaceSampleCountSpinBox"><property name="minimum"><number>50</number></property><property name="maximum"><number>5000</number></property><property name="singleStep"><number>50</number></property><property name="value"><number>600</number></property><property name="SlicerParameterName" stdset="0"><string>robotWorkspaceSampleCount</string></property></widget></item>
         </layout></item>
         <item><layout class="QHBoxLayout" name="robotWorkspaceButtonLayout">
          <item><widget class="QPushButton" name="generateRobotWorkspaceButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Generate / Refresh Workspace</string></property></widget></item>
          <item><widget class="QPushButton" name="clearRobotWorkspaceButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Clear Workspace</string></property></widget></item>
         </layout></item>
         <item><widget class="QLabel" name="robotWorkspaceStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>No workspace cloud generated.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout>
       </widget>
      </item>
      <item>
<widget class="QGroupBox" name="step6TrajectoryPlanningGroupBox">
        <property name="title"><string>6.4 — Trajectory Motion Planning (simulation)</string></property>
        <layout class="QVBoxLayout" name="step6TrajectoryPlanningVerticalLayout">
         <item><widget class="QLabel" name="step6TrajectoryPlanningDescriptionLabel"><property name="text"><string>Plan a joint-space path along the approved Entry-to-Target trajectory. Each sample is screened with coarse self-collision AABBs and a subsampled environment point cloud. Preview streams simulated joint motion only.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item>
          <layout class="QFormLayout" name="step6TrajectoryPlanningFormLayout">
           <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Trajectory samples:</string></property></widget></item>
           <item row="0" column="1"><widget class="QSpinBox" name="robotMotionPlanSampleCountSpinBox"><property name="minimum"><number>2</number></property><property name="maximum"><number>64</number></property><property name="value"><number>12</number></property><property name="SlicerParameterName" stdset="0"><string>robotMotionPlanSampleCount</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Self-clearance (mm):</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="robotCoarseSelfClearanceSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>5.0</double></property><property name="maximum"><double>50.0</double></property><property name="value"><double>5.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotCoarseSelfClearanceMm</string></property></widget></item>
           <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Environment clearance (mm):</string></property></widget></item>
           <item row="2" column="1"><widget class="QDoubleSpinBox" name="robotEnvironmentClearanceSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>50.0</double></property><property name="value"><double>2.0</double></property><property name="SlicerParameterName" stdset="0"><string>robotEnvironmentClearanceMm</string></property></widget></item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="step6TrajectoryPlanningButtonLayout">
           <item><widget class="QPushButton" name="planTrajectoryMotionButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Plan Motion Along Trajectory</string></property></widget></item>
           <item><widget class="QPushButton" name="previewTrajectoryMotionButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Preview Simulated Motion</string></property></widget></item>
           <item><widget class="QPushButton" name="stopTrajectoryMotionButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Stop Preview</string></property></widget></item>
          </layout>
         </item>
         <item><widget class="QLabel" name="step6TrajectoryPlanningStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>No motion plan yet.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout>
       </widget>
      </item>
      <item><widget class="QLabel" name="robotPlacementStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>Choose a scene in 6.0, then load the ROS robot in 6.1.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
      <item><widget class="QLabel" name="robotPlacementSafetyLabel"><property name="styleSheet"><string notr="true">color: #b00020; font-weight: 600;</string></property><property name="text"><string>SIMULATION / RESEARCH ONLY — no controller or hardware command path is connected. Head mount, calibrated TCP, patient motion, cables, swept-volume collision, forces, and clinical safety are not yet represented.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
