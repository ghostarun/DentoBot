          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property>
          <property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>targetDockingAssemblyModel</string></property>
         </widget>
        </item>
        <item row="3" column="0"><widget class="QLabel" name="targetDockingPatternRadiusLabel"><property name="text"><string>Centroid-to-dock radius:</string></property></widget></item>
        <item row="3" column="1"><widget class="QDoubleSpinBox" name="targetDockingPatternRadiusSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>2.000000000000000</double></property><property name="maximum"><double>40.000000000000000</double></property><property name="singleStep"><double>0.500000000000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>15.000000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingPatternRadiusMm</string></property></widget></item>
        <item row="4" column="0"><widget class="QLabel" name="targetDockingOuterDiameterLabel"><property name="text"><string>Dock outer diameter:</string></property></widget></item>
        <item row="4" column="1"><widget class="QDoubleSpinBox" name="targetDockingOuterDiameterSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.40</double></property><property name="maximum"><double>12.0</double></property><property name="singleStep"><double>0.10</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>3.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingOuterDiameterMm</string></property></widget></item>
        <item row="5" column="0"><widget class="QLabel" name="targetDockingBoreDiameterLabel"><property name="text"><string>Dock bore diameter:</string></property></widget></item>
        <item row="5" column="1"><widget class="QDoubleSpinBox" name="targetDockingBoreDiameterSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.20</double></property><property name="maximum"><double>10.0</double></property><property name="singleStep"><double>0.10</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>1.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingBoreDiameterMm</string></property></widget></item>
        <item row="6" column="0"><widget class="QLabel" name="targetDockingConnectorDiameterLabel"><property name="text"><string>Shell-attachment branch width:</string></property></widget></item>
        <item row="6" column="1"><widget class="QDoubleSpinBox" name="targetDockingConnectorDiameterSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.40</double></property><property name="maximum"><double>12.0</double></property><property name="singleStep"><double>0.10</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>3.5</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingConnectorDiameterMm</string></property></widget></item>
        <item row="7" column="0"><widget class="QLabel" name="targetDockingConnectorThicknessLabel"><property name="text"><string>Branch endpoint overlap:</string></property></widget></item>
        <item row="7" column="1"><widget class="QDoubleSpinBox" name="targetDockingConnectorThicknessSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.50</double></property><property name="maximum"><double>12.0</double></property><property name="singleStep"><double>0.10</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>2.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingConnectorThicknessMm</string></property></widget></item>
        <item row="8" column="0"><widget class="QLabel" name="targetDockingSharedDepthLabel"><property name="text"><string>Shared depth from top face:</string></property></widget></item>
        <item row="8" column="1"><widget class="QDoubleSpinBox" name="targetDockingSharedDepthSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.50</double></property><property name="maximum"><double>30.0</double></property><property name="singleStep"><double>0.50</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>5.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingSharedDepthMm</string></property></widget></item>
        <item row="9" column="0"><widget class="QLabel" name="targetDockingCollisionClearanceLabel"><property name="text"><string>Obstacle clearance:</string></property></widget></item>
        <item row="9" column="1"><widget class="QDoubleSpinBox" name="targetDockingCollisionClearanceSpinBox"><property name="toolTip"><string>Draft yaw search expands each dock by this clearance while screening all other same-jaw whole-tooth surfaces. This surface-sampling screen is not clinical collision validation.</string></property><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>10.0</double></property><property name="singleStep"><double>0.10</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>0.5</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingCollisionClearanceMm</string></property></widget></item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="targetDockingIndividualDepthsCheckBox"><property name="text"><string>Unlock four individual dock depths</string></property><property name="SlicerParameterName" stdset="0"><string>targetDockingIndividualDepthsEnabled</string></property></widget>
      </item>
      <item>
       <widget class="QWidget" name="targetDockingIndividualDepthsWidget">
        <layout class="QGridLayout" name="targetDockingIndividualDepthsLayout">
         <item row="0" column="0"><widget class="QLabel" name="targetDockingDepth1Label"><property name="text"><string>+X:</string></property></widget></item>
         <item row="0" column="1"><widget class="QDoubleSpinBox" name="targetDockingDepth1SpinBox"><property name="minimum"><double>0.5</double></property><property name="maximum"><double>30.0</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>5.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingDepth1Mm</string></property></widget></item>
         <item row="0" column="2"><widget class="QLabel" name="targetDockingDepth2Label"><property name="text"><string>+Y:</string></property></widget></item>
         <item row="0" column="3"><widget class="QDoubleSpinBox" name="targetDockingDepth2SpinBox"><property name="minimum"><double>0.5</double></property><property name="maximum"><double>30.0</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>5.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingDepth2Mm</string></property></widget></item>
         <item row="1" column="0"><widget class="QLabel" name="targetDockingDepth3Label"><property name="text"><string>−X:</string></property></widget></item>
         <item row="1" column="1"><widget class="QDoubleSpinBox" name="targetDockingDepth3SpinBox"><property name="minimum"><double>0.5</double></property><property name="maximum"><double>30.0</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>5.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingDepth3Mm</string></property></widget></item>
         <item row="1" column="2"><widget class="QLabel" name="targetDockingDepth4Label"><property name="text"><string>−Y:</string></property></widget></item>
         <item row="1" column="3"><widget class="QDoubleSpinBox" name="targetDockingDepth4SpinBox"><property name="minimum"><double>0.5</double></property><property name="maximum"><double>30.0</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>5.0</double></property><property name="SlicerParameterName" stdset="0"><string>targetDockingDepth4Mm</string></property></widget></item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="targetDockingOrientationGroupBox">
        <property name="title"><string>Collision-aware draft orientation</string></property>
        <layout class="QVBoxLayout" name="targetDockingOrientationVerticalLayout">
         <item><widget class="QLabel" name="targetDockingAutoYawStatusLabel"><property name="text"><string>Generate a draft to calculate yaw against same-jaw tooth surfaces.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #1f5f99;</string></property></widget></item>
         <item>
          <layout class="QHBoxLayout" name="targetDockingYawSliderLayout">
           <item><widget class="QLabel" name="targetDockingYawTitleLabel"><property name="text"><string>Yaw:</string></property></widget></item>
           <item><widget class="QSlider" name="targetDockingYawSlider"><property name="toolTip"><string>Rotate all four dock positions around the fitted occlusal-plane normal. Moving the slider makes the draft stale; Apply rebuilds it, and Confirm is required afterward.</string></property><property name="minimum"><number>-180</number></property><property name="maximum"><number>180</number></property><property name="singleStep"><number>1</number></property><property name="pageStep"><number>5</number></property><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="tracking"><bool>true</bool></property></widget></item>
           <item><widget class="QLabel" name="targetDockingYawValueLabel"><property name="minimumSize"><size><width>48</width><height>0</height></size></property><property name="text"><string>0°</string></property><property name="alignment"><set>Qt::AlignRight|Qt::AlignVCenter</set></property></widget></item>
          </layout>
         </item>
         <item><layout class="QHBoxLayout" name="targetDockingOrientationButtonLayout"><item><widget class="QPushButton" name="applyTargetDockingYawButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Apply Yaw to Draft</string></property></widget></item><item><widget class="QPushButton" name="confirmTargetDockingYawButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Confirm Dock Orientation</string></property></widget></item></layout></item>
         <item><widget class="QCheckBox" name="targetDockingMeasurementsVisibleCheckBox"><property name="text"><string>Show centroid, distance, diameter, and depth annotations</string></property><property name="checked"><bool>true</bool></property><property name="SlicerParameterName" stdset="0"><string>targetDockingMeasurementsVisible</string></property></widget></item>
         <item><widget class="QLabel" name="targetDockingOrientationStateLabel"><property name="text"><string>DRAFT — orientation not confirmed</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #b36b00; font-weight: 700;</string></property></widget></item>
        </layout>
       </widget>
      </item>
      <item>
       <layout class="QGridLayout" name="targetDockingButtonLayout">
        <item row="0" column="0"><widget class="QPushButton" name="generateTargetDockingAssemblyButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Auto-Place Collision-Checked Draft</string></property></widget></item>
        <item row="0" column="1"><widget class="QPushButton" name="deleteTargetDockingAssemblyButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Delete Step 4C Assembly...</string></property></widget></item>
       </layout>
      </item>
      <item><widget class="QLabel" name="targetDockingStatusLabel"><property name="text"><string>Complete and lock one or two target-tooth trajectories first.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #b36b00;</string></property></widget></item>
      <item><widget class="QLabel" name="targetDockingSafetyLabel"><property name="text"><string>Provisional research geometry only. The four-hole profile, fit tolerances, material strength, registration semantics, and robot load path require mechanical validation.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #b36b00;</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="templateModelingCollapsibleButton">
     <property name="text">
      <string>Step 4B — Select Support Teeth and Build Anatomy Draft</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="templateModelingVerticalLayout">
      <item>
       <widget class="QLabel" name="templateModelingDescriptionLabel">
        <property name="text">
         <string>The Step 4A target is fixed. Select supporting teeth from its same-jaw visual arch, then define the editable boundary around only the clinically visible erupted support surfaces. Full crown-and-root anatomy remains available for planning but is not the template fitting surface.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="templateModelingLineageLabel">
        <property name="minimumSize">
         <size>
          <width>0</width>
          <height>28</height>
         </size>
        </property>
        <property name="toolTip">
         <string>The color is inherited from the authoritative Step 4A target-tooth trajectory. MRML references and target IDs remain authoritative.</string>
        </property>
        <property name="styleSheet">
         <string notr="true">QLabel { color: #555555; background-color: #eeeeee; border-left: 8px solid #999999; border-radius: 3px; padding: 5px 8px; }</string>
        </property>
        <property name="text">
         <string>Target lineage: create a Step 4A trajectory to assign a color.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="templateModelingFormLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="templateTargetToothTitleLabel">
          <property name="text">
           <string>Target tooth:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLabel" name="templateTargetToothValueLabel">
          <property name="text">
           <string>--</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
          <property name="textInteractionFlags">
           <set>Qt::TextSelectableByMouse</set>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="templateSupportTeethTitleLabel">
          <property name="text">
           <string>Support teeth:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QListWidget" name="templateSupportTeethListWidget">
          <property name="toolTip">
           <string>Internal scene-backed support selection. The visible arch control limits selection to the target jaw; the target itself is always included and cannot be selected again.</string>
          </property>
          <property name="minimumSize">
           <size>
            <width>0</width>
            <height>120</height>
           </size>
          </property>
          <property name="selectionMode">
           <enum>QAbstractItemView::NoSelection</enum>
          </property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="draftTemplateSupportModelTitleLabel">
          <property name="text">
           <string>Draft model:</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="qMRMLNodeComboBox" name="draftTemplateSupportModelSelector">
          <property name="toolTip">
           <string>Authoritative Step 4B draft support-anatomy model stored in the scene.</string>
          </property>
          <property name="nodeTypes">
           <stringlist notr="true">
            <string>vtkMRMLModelNode</string>
           </stringlist>
          </property>
          <property name="showChildNodeTypes">
           <bool>false</bool>
          </property>
          <property name="noneEnabled">
           <bool>true</bool>
          </property>
          <property name="addEnabled">
           <bool>false</bool>
          </property>
          <property name="removeEnabled">
           <bool>false</bool>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>draftTemplateSupportModel</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="templateSupportBoundaryCurveLabel">
          <property name="text"><string>Visible-surface boundary:</string></property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="qMRMLNodeComboBox" name="templateSupportBoundaryCurveSelector">
          <property name="toolTip"><string>Editable DENTOBOT closed curve defining the erupted tooth surfaces that may contact the template.</string></property>
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsClosedCurveNode</string></stringlist></property>
          <property name="showChildNodeTypes"><bool>false</bool></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>templateSupportBoundaryCurve</string></property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="templateSupportSelectionModeLabel">
          <property name="text"><string>Crown/root direction:</string></property>
         </widget>
        </item>
        <item row="4" column="1">
         <layout class="QHBoxLayout" name="templateSupportDirectionLayout">
          <item>
           <widget class="QLabel" name="templateSupportDirectionValueLabel">
            <property name="toolTip"><string>Entry to Target on the selected target-tooth trajectory is used as crown-to-root insertion direction. The opposite vector selects the crown-side patch on every support tooth.</string></property>
            <property name="text"><string>Select a complete target trajectory in Step 4A.</string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="flipTemplateSupportDirectionButton">
            <property name="enabled"><bool>false</bool></property>
            <property name="checkable"><bool>true</bool></property>
            <property name="toolTip"><string>Exceptional override: reverse the selected target trajectory polarity for all target/support teeth. Leave off for the normal Entry-to-Target crown-to-root convention.</string></property>
            <property name="text"><string>Reverse polarity</string></property>
           </widget>
          </item>
         </layout>
        </item>
        <item row="5" column="0">
         <widget class="QLabel" name="templateSupportCurveSamplingSpacingLabel">
          <property name="text"><string>Boundary sampling:</string></property>
         </widget>
        </item>
        <item row="5" column="1">
         <widget class="QDoubleSpinBox" name="templateSupportCurveSamplingSpacingSpinBox">
          <property name="toolTip"><string>World-RAS spacing used to resample the closed boundary for robust Dijkstra surface mapping. This affects derived processing only.</string></property>
          <property name="suffix"><string> mm</string></property>
          <property name="decimals"><number>2</number></property>
          <property name="minimum"><double>0.100000000000000</double></property>
          <property name="maximum"><double>2.000000000000000</double></property>
          <property name="singleStep"><double>0.100000000000000</double></property>
          <property name="value"><double>0.500000000000000</double></property>
          <property name="SlicerParameterName" stdset="0"><string>templateSupportCurveSamplingSpacingMm</string></property>
         </widget>
        </item>
        <item row="6" column="0">
         <widget class="QLabel" name="templateTerminalSupportCoverageLabel">
          <property name="text"><string>Terminal tooth coverage:</string></property>
         </widget>
        </item>
        <item row="6" column="1">
         <widget class="QDoubleSpinBox" name="templateTerminalSupportCoverageSpinBox">
          <property name="toolTip"><string>Retain this inward percentage of each non-target tooth at the two ends of the selected support span. The target tooth is preserved when it is terminal, as in an edge-molar case. Adjacent unselected teeth remain collision-only anatomy.</string></property>
          <property name="suffix"><string> %</string></property>
          <property name="decimals"><number>0</number></property>
          <property name="minimum"><double>25.000000000000000</double></property>
          <property name="maximum"><double>100.000000000000000</double></property>
          <property name="singleStep"><double>5.000000000000000</double></property>
          <property name="value"><double>50.000000000000000</double></property>
          <property name="SlicerParameterName" stdset="0"><string>templateTerminalSupportCoveragePercent</string></property>
         </widget>
        </item>
        <item row="7" column="0">
         <widget class="QLabel" name="visibleTemplateSupportModelLabel">
          <property name="text"><string>Visible support preview:</string></property>
         </widget>
        </item>
        <item row="7" column="1">
         <widget class="qMRMLNodeComboBox" name="visibleTemplateSupportModelSelector">
          <property name="toolTip"><string>Derived preview containing only the selected visible patient-contact support surface. It never replaces the authoritative segmentation.</string></property>
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property>
          <property name="showChildNodeTypes"><bool>false</bool></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>visibleTemplateSupportModel</string></property>
         </widget>
        </item>
        <item row="8" column="0">
         <widget class="QLabel" name="templateSupportBoundaryPlaneLabel">
          <property name="text"><string>Automatic support plane:</string></property>
         </widget>
        </item>
        <item row="8" column="1">
         <widget class="qMRMLNodeComboBox" name="templateSupportBoundaryPlaneSelector">
          <property name="toolTip"><string>Locked plane used to initialize the editable visible-support boundary. Entry-to-Target defines crown/root polarity; selected crown caps estimate local occlusal tilt. Adjust its depth and fit percentage below.</string></property>
          <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsPlaneNode</string></stringlist></property>
          <property name="showChildNodeTypes"><bool>false</bool></property>
          <property name="noneEnabled"><bool>true</bool></property>
          <property name="addEnabled"><bool>false</bool></property>
          <property name="removeEnabled"><bool>false</bool></property>
          <property name="SlicerParameterName" stdset="0"><string>templateSupportBoundaryPlane</string></property>
         </widget>
        </item>
        <item row="9" column="0">
         <widget class="QLabel" name="templateSupportPlaneDepthLabel">
          <property name="text"><string>Plane depth from Entry:</string></property>
         </widget>
        </item>
        <item row="9" column="1">
         <widget class="QDoubleSpinBox" name="templateSupportPlaneDepthSpinBox">
          <property name="toolTip"><string>Move the locked plane only along Entry-to-Target. This is a research starting position, not an automatically detected gingival margin.</string></property>
          <property name="suffix"><string> mm</string></property>
          <property name="decimals"><number>1</number></property>
          <property name="minimum"><double>-10.000000000000000</double></property>
          <property name="maximum"><double>20.000000000000000</double></property>
          <property name="singleStep"><double>0.500000000000000</double></property>
          <property name="value"><double>3.000000000000000</double></property>
          <property name="SlicerParameterName" stdset="0"><string>templateSupportPlaneDepthMm</string></property>
         </widget>
        </item>
        <item row="10" column="0">
         <widget class="QLabel" name="templateSupportCrownCapLabel">
          <property name="text"><string>Crown-cap tilt fit:</string></property>
         </widget>
        </item>
        <item row="10" column="1">
         <widget class="QDoubleSpinBox" name="templateSupportCrownCapSpinBox">
          <property name="toolTip"><string>Use this crownward percentage of each selected tooth to estimate the local occlusal-plane tilt. Entry-to-Target defines crown/root polarity. This is a geometric initializer, not gingival-margin detection.</string></property>
          <property name="suffix"><string> %</string></property>
          <property name="decimals"><number>0</number></property>
          <property name="minimum"><double>5.000000000000000</double></property>
          <property name="maximum"><double>30.000000000000000</double></property>
          <property name="singleStep"><double>1.000000000000000</double></property>
          <property name="value"><double>10.000000000000000</double></property>
          <property name="SlicerParameterName" stdset="0"><string>templateSupportCrownCapPercent</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QPushButton" name="reviewSegmentationForTemplateButton">
        <property name="visible">
         <bool>false</bool>
        </property>
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Open the authoritative segmentation review controls. Inspect the new or corrected segmentation and explicitly set its workflow review state to Reviewed before generating derived template geometry.</string>
        </property>
        <property name="text">
         <string>Open Segmentation Review</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="createDraftTemplateSupportModelButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Create or explicitly update one draft model from the target and all checked support teeth. Source segmentation surfaces are not modified.</string>
        </property>
        <property name="text">
         <string>Create Draft Support Model</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="deleteDraftTemplateSupportModelButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="toolTip">
         <string>Permanently remove only the selected DENTOBOT draft support-anatomy model after confirmation. The segmentation, target tooth, and checked support teeth are preserved.</string>
        </property>
        <property name="text">
         <string>Delete Draft Support Model...</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="templateSupportViewControlsGroupBox">
        <property name="title"><string>Support-surface view</string></property>
        <property name="toolTip"><string>Viewport-only controls for reviewing the selected target and support teeth. Source segmentation masks and derived geometry are not changed.</string></property>
        <layout class="QGridLayout" name="templateSupportViewControlsLayout">
         <item row="0" column="0">
          <widget class="QPushButton" name="focusTemplateSupportButton">
           <property name="enabled"><bool>false</bool></property>
           <property name="toolTip"><string>Temporarily show only the target and checked support teeth and hide duplicate derived previews while the support margin is reviewed.</string></property>
           <property name="text"><string>Show Selected Teeth Only</string></property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QPushButton" name="frameTemplateSupportButton">
           <property name="enabled"><bool>false</bool></property>
           <property name="toolTip"><string>Centre the current draft support model in every active 2D slice and 3D viewport.</string></property>
           <property name="text"><string>Frame Support in All Views</string></property>
          </widget>
         </item>
         <item row="1" column="0" colspan="2">
          <widget class="QPushButton" name="restoreTemplateSupportFocusButton">
           <property name="enabled"><bool>false</bool></property>
           <property name="toolTip"><string>Restore the exact segmentation and model visibility saved before support-only focus.</string></property>
           <property name="text"><string>Restore Scene</string></property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="templateSupportPlaneButtonLayout">
        <item>
         <widget class="QPushButton" name="createTemplateSupportPlaneButton">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Create or reset a locked plane whose polarity comes from Entry-to-Target and whose local tilt is fitted from selected crown caps. The position is controlled by Plane depth from Entry.</string></property>
          <property name="text"><string>Create / Reset Support Plane</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="generateTemplateSupportBoundaryFromPlaneButton">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Intersect the plane with every selected tooth, create one continuous editable outer boundary across the support group, and generate the visible support preview.</string></property>
          <property name="text"><string>Generate Boundary + Preview</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="templateSupportBoundaryButtonLayout">
        <item>
         <widget class="QPushButton" name="createTemplateSupportBoundaryButton">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Place one closed loop directly on the orange draft teeth near the intended gingival/cervical margin, then right-click to finish. The loop may address only a subset of the disconnected selected teeth; source anatomy is not modified.</string></property>
          <property name="text"><string>Manual: Draw / Redraw Boundary</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="generateVisibleTemplateSupportModelButton">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Evaluate both boundary sides per tooth and retain the crown-side patch using the selected target trajectory direction. Disconnected mesh islands are diagnostics inside their source tooth, not additional teeth.</string></property>
          <property name="text"><string>Generate / Update Visible Support Preview</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QPushButton" name="deleteTemplateSupportSelectionButton">
        <property name="enabled"><bool>false</bool></property>
        <property name="toolTip"><string>Delete the DENTOBOT-owned visible support boundary and derived preview while preserving the segmentation and selected teeth.</string></property>
        <property name="text"><string>Delete Visible Support Selection...</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="templateSupportSurfaceStatusLabel">
        <property name="styleSheet"><string notr="true">color: #b36b00;</string></property>
        <property name="text"><string>Create the full support model, then place one closed loop directly on the orange teeth near the intended gingival/cervical margin and right-click to finish.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="templateModelingStatusLabel">
        <property name="styleSheet">
         <string notr="true">color: #b36b00;</string>
        </property>
        <property name="text">
         <string>Select a reviewed dental segmentation and target tooth.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="templateModelingSafetyLabel">
        <property name="styleSheet">
         <string notr="true">color: #b36b00;</string>
        </property>
        <property name="text">
         <string>The visible support preview is derived research geometry only. It is not yet an undercut-corrected fitting surface, printable template, manufacturing approval, clinical validation, or authorization to drill.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="templateGuideCollapsibleButton">
     <property name="text">
      <string>Step 5B — Patient-Contact Shell and Guide Integration</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="templateGuideVerticalLayout">
      <item>
       <widget class="QLabel" name="templateGuideDescriptionLabel">
        <property name="text">
         <string>Generate the undercut-aware patient-contact shell, then fuse the approved trajectory guide hole(s) and the current Step 4C four-dock rail assembly into one connected final template.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="ctkCollapsibleButton" name="patientContactShellGroupBox">
        <property name="text"><string>Fit analysis + cached patient-contact shell</string></property>
        <property name="collapsed"><bool>false</bool></property>
        <layout class="QVBoxLayout" name="patientContactShellVerticalLayout">
         <item>
          <layout class="QFormLayout" name="patientContactShellFormLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="patientContactShellSourceLabel"><property name="text"><string>Visible support source:</string></property></widget>
           </item>
           <item row="0" column="1">
            <widget class="QLabel" name="patientContactShellSourceValueLabel"><property name="text"><string>--</string></property><property name="wordWrap"><bool>true</bool></property></widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="patientContactShellModelLabel"><property name="text"><string>Patient-contact shell:</string></property></widget>
           </item>
           <item row="1" column="1">
            <widget class="qMRMLNodeComboBox" name="patientContactShellModelSelector">
             <property name="toolTip"><string>Derived undercut-aware shell made from the current visible support surface, insertion direction, Dynamic Modeler Margin/Hollow, and a tightly cropped voxel clearance Boolean.</string></property>
             <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property>
             <property name="showChildNodeTypes"><bool>false</bool></property>
             <property name="noneEnabled"><bool>true</bool></property>
             <property name="addEnabled"><bool>false</bool></property>
             <property name="removeEnabled"><bool>false</bool></property>
             <property name="SlicerParameterName" stdset="0"><string>patientContactShellModel</string></property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="templateInsertionDirectionLabel"><property name="text"><string>Derived insertion direction:</string></property></widget>
           </item>
           <item row="2" column="1">
            <layout class="QHBoxLayout" name="templateInsertionDirectionLayout">
             <item>
              <widget class="qMRMLNodeComboBox" name="templateInsertionDirectionSelector">
               <property name="enabled"><bool>false</bool></property>
               <property name="toolTip"><string>Automatically derived from the selected target trajectory. Entry to Target is Approach to Seat; removal/crown direction is opposite. Use the Step 5A Reverse polarity override only for an exceptional case.</string></property>
               <property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLMarkupsLineNode</string></stringlist></property>
               <property name="showChildNodeTypes"><bool>false</bool></property>
               <property name="noneEnabled"><bool>true</bool></property>
               <property name="addEnabled"><bool>false</bool></property>
               <property name="removeEnabled"><bool>false</bool></property>
               <property name="SlicerParameterName" stdset="0"><string>templateInsertionDirection</string></property>
              </widget>
             </item>
             <item><widget class="QPushButton" name="createTemplateInsertionDirectionButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Refresh from trajectory</string></property></widget></item>
             <item><widget class="QPushButton" name="deleteTemplateInsertionDirectionButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Delete...</string></property></widget></item>
            </layout>
           </item>
           <item row="3" column="0"><widget class="QLabel" name="templateUndercutAngleToleranceLabel"><property name="text"><string>Undercut angle tolerance:</string></property></widget></item>
           <item row="3" column="1">
            <widget class="QDoubleSpinBox" name="templateUndercutAngleToleranceSpinBox">
             <property name="toolTip"><string>Surface normals must point farther than this tolerance behind the removal-perpendicular plane to be classified as retentive.</string></property>
             <property name="decimals"><number>1</number></property><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>45.000000000000000</double></property><property name="singleStep"><double>1.000000000000000</double></property><property name="suffix"><string> deg</string></property><property name="value"><double>5.000000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>templateUndercutAngleToleranceDeg</string></property>
            </widget>
           </item>
           <item row="4" column="0"><widget class="QLabel" name="templateInterproximalReliefLabel"><property name="text"><string>Interproximal relief:</string></property></widget></item>
           <item row="4" column="1">
            <widget class="QDoubleSpinBox" name="templateInterproximalReliefSpinBox">
             <property name="toolTip"><string>Maximum transverse interdental/terminal embrasure opening to close in the insertion-frame collision blockout. Adjacent same-arch teeth are collision-only anatomy and never become fitting surfaces. Research default only.</string></property>
             <property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>5.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>1.000000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>templateInterproximalReliefMm</string></property>
            </widget>
           </item>
           <item row="5" column="0"><widget class="QLabel" name="templateBlockoutSafetyLabel"><property name="text"><string>Blockout safety:</string></property></widget></item>
           <item row="5" column="1">
            <widget class="QDoubleSpinBox" name="templateBlockoutSafetySpinBox">
             <property name="toolTip"><string>Additional removable-fit clearance applied against the directional blockout. Research default only.</string></property>
             <property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>3.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>0.100000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>templateBlockoutSafetyMm</string></property>
            </widget>
           </item>
           <item row="6" column="0"><widget class="QLabel" name="templateShellVoxelClosingLabel"><property name="text"><string>Voxel closing:</string></property></widget></item>
           <item row="6" column="1">
            <widget class="QDoubleSpinBox" name="templateShellVoxelClosingSpinBox">
             <property name="toolTip"><string>Morphological closing radius for derived shell robustness. Clearance is re-enforced afterward.</string></property>
             <property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>5.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>0.300000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>templateShellVoxelClosingMm</string></property>
            </widget>
           </item>
           <item row="7" column="0"><widget class="QLabel" name="templateUndercutSurfaceModelLabel"><property name="text"><string>Undercut preview:</string></property></widget></item>
           <item row="7" column="1">
            <widget class="qMRMLNodeComboBox" name="templateUndercutSurfaceModelSelector"><property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property><property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property><property name="SlicerParameterName" stdset="0"><string>templateUndercutSurfaceModel</string></property></widget>
           </item>
           <item row="8" column="0"><widget class="QLabel" name="templateUndercutBlockoutModelLabel"><property name="text"><string>Directional blockout:</string></property></widget></item>
           <item row="8" column="1">
            <widget class="qMRMLNodeComboBox" name="templateUndercutBlockoutModelSelector"><property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property><property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property><property name="SlicerParameterName" stdset="0"><string>templateUndercutBlockoutModel</string></property></widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="patientContactShellButtonLayout">
           <item><widget class="QPushButton" name="analyzeTemplateUndercutsButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Analyze / Update Blockout</string></property></widget></item>
           <item><widget class="QPushButton" name="generatePatientContactShellButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Generate / Refresh Cached Patient Shell</string></property><property name="toolTip"><string>Advanced staged action: update only the patient-contact shell from the current visible surface, insertion-direction blockout, fit clearance, shell thickness, sampling resolution, and voxel closing values. The complete-template action below reuses this shell while it remains current.</string></property></widget></item>
           <item><widget class="QPushButton" name="deletePatientContactShellButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Delete Patient-Contact Shell...</string></property></widget></item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="patientContactShellStatusLabel"><property name="styleSheet"><string notr="true">color: #b36b00;</string></property><property name="text"><string>Generate a current visible support preview in Step 5A first.</string></property><property name="wordWrap"><bool>true</bool></property></widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="ctkCollapsibleButton" name="templateDockingFusionGroupBox">
        <property name="text"><string>Build unified template — trajectories + four docks</string></property>
        <property name="collapsed"><bool>false</bool></property>
        <layout class="QVBoxLayout" name="templateDockingFusionVerticalLayout">
         <item><widget class="QLabel" name="templateDockingFusionDescriptionLabel"><property name="text"><string>The primary action generates only missing or stale stages: directional blockout, cached patient shell, then trajectory-aligned drill guides and the confirmed Step 4C four-dock assembly. A current patient shell is reused unchanged when only guide/dock parameters need rebuilding. Inspection buttons change visibility only and never recompute geometry.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><widget class="QListWidget" name="templateGuideTrajectoriesListWidget"><property name="minimumSize"><size><width>0</width><height>90</height></size></property><property name="toolTip"><string>Read-only source list. The exact locked trajectory set used by the confirmed Step 4C dock assembly is included automatically so shell fusion cannot silently use a different drill plan.</string></property></widget></item>
         <item>
          <layout class="QFormLayout" name="templateDockingFusionFormLayout">
           <item row="0" column="0"><widget class="QLabel" name="templateDockingClearanceLabel"><property name="text"><string>Drill-guide exclusion clearance:</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="templateDockingClearanceSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>3.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>0.300000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>templateDockingClearanceMm</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="templateReinforcementRadialLabel"><property name="text"><string>Drill-guide collar radial width:</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="templateReinforcementRadialSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.100000000000000</double></property><property name="maximum"><double>8.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>1.000000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>templateReinforcementRadialMm</string></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="templateReinforcementDepthLabel"><property name="text"><string>Drill-guide collar shell depth:</string></property></widget></item>
           <item row="2" column="1"><widget class="QDoubleSpinBox" name="templateReinforcementDepthSpinBox"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.100000000000000</double></property><property name="maximum"><double>10.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property><property name="suffix"><string> mm</string></property><property name="value"><double>2.000000000000000</double></property><property name="SlicerParameterName" stdset="0"><string>templateReinforcementDepthMm</string></property></widget></item>
           <item row="3" column="0"><widget class="QLabel" name="finalPrintableTemplateModelLabel"><property name="text"><string>Unified template:</string></property></widget></item>
           <item row="3" column="1"><widget class="qMRMLNodeComboBox" name="finalPrintableTemplateModelSelector"><property name="nodeTypes"><stringlist notr="true"><string>vtkMRMLModelNode</string></stringlist></property><property name="noneEnabled"><bool>true</bool></property><property name="addEnabled"><bool>false</bool></property><property name="removeEnabled"><bool>false</bool></property><property name="SlicerParameterName" stdset="0"><string>finalPrintableTemplateModel</string></property></widget></item>
          </layout>
         </item>
         <item><layout class="QHBoxLayout" name="templateDockingFusionButtonLayout"><item><widget class="QPushButton" name="generateFinalPrintableTemplateButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Build Complete Template (Missing/Stale Stages Only)</string></property><property name="toolTip"><string>Preflight the confirmed Step 4C assembly and locked trajectories, generate only a missing/stale blockout or patient shell, then rebuild fusion only when required. Current cached geometry is never regenerated merely for inspection.</string></property></widget></item><item><widget class="QPushButton" name="deleteFinalPrintableTemplateButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Delete Unified Template...</string></property></widget></item></layout></item>
         <item>
          <layout class="QHBoxLayout" name="templateInspectionButtonLayout">
           <item><widget class="QPushButton" name="inspectTemplateFitButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Inspect Fit / Undercuts</string></property><property name="toolTip"><string>Display the visible support, insertion direction, undercut preview, and blockout without generating geometry.</string></property></widget></item>
           <item><widget class="QPushButton" name="inspectShellAndGuidesButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Inspect Shell + Guides</string></property><property name="toolTip"><string>Display the cached shell, trajectories, guide/dock geometry, and auxiliaries without generating geometry.</string></property></widget></item>
           <item><widget class="QPushButton" name="inspectUnifiedTemplateButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>Inspect Unified Only</string></property><property name="toolTip"><string>Isolate and frame the current unified printable template without regenerating it.</string></property></widget></item>
          </layout>
         </item>
         <item><widget class="QLabel" name="templateDockingFusionStatusLabel"><property name="text"><string>Generate an undercut-aware patient-contact shell first.</string></property><property name="wordWrap"><bool>true</bool></property><property name="styleSheet"><string notr="true">color: #b36b00;</string></property></widget></item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="templateGuideLineageLabel">
        <property name="minimumSize">
         <size>
          <width>0</width>
          <height>28</height>
         </size>
        </property>
        <property name="toolTip">
         <string>Step 5B inputs and outputs inherit the authoritative Step 4A target-tooth color through their Step 4B/5A MRML references.</string>
        </property>
        <property name="styleSheet">
         <string notr="true">QLabel { color: #555555; background-color: #eeeeee; border-left: 8px solid #999999; border-radius: 3px; padding: 5px 8px; }</string>
        </property>
        <property name="text">
         <string>Inherited lineage: waiting for a colored Step 4B/5A/Step 4A input.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="templateGuideFormLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="templateShellRoiLabel">
          <property name="text">
           <string>Automatic shell bounds ROI:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="qMRMLNodeComboBox" name="templateShellRoiSelector">
          <property name="nodeTypes">
           <stringlist notr="true">
            <string>vtkMRMLMarkupsROINode</string>
           </stringlist>
          </property>
          <property name="noneEnabled">
           <bool>true</bool>
          </property>
          <property name="addEnabled">
           <bool>false</bool>
          </property>
          <property name="removeEnabled">
           <bool>false</bool>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>templateShellRoi</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <layout class="QHBoxLayout" name="templateShellRoiButtonLayout">
          <item>
           <widget class="QPushButton" name="createTemplateShellRoiButton">
            <property name="text">
             <string>Create / Reset Automatic ROI</string>
            </property>
            <property name="toolTip">
             <string>Create or recompute the locked world-RAS bounds around the Step 4B support draft. This workflow-owned ROI is visible for reference but cannot be picked, moved, rotated, or resized in a view.</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="deleteTemplateShellRoiButton">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="text">
             <string>Delete Automatic ROI...</string>
            </property>
            <property name="toolTip">
             <string>Delete only the DENTOBOT-owned automatic Step 5B bounds ROI so a fresh one can be generated. Existing shell and sleeve outputs are retained but marked stale.</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="templateShellClearanceLabel">
          <property name="text">
           <string>Shell clearance:</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QDoubleSpinBox" name="templateShellClearanceSpinBox">
          <property name="decimals"><number>2</number></property>
          <property name="minimum"><double>0.000000000000000</double></property>
          <property name="maximum"><double>5.000000000000000</double></property>
          <property name="singleStep"><double>0.100000000000000</double></property>
          <property name="suffix"><string> mm</string></property>
          <property name="SlicerParameterName" stdset="0"><string>templateShellClearanceMm</string></property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="templateShellThicknessLabel">
          <property name="text"><string>Shell thickness:</string></property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QDoubleSpinBox" name="templateShellThicknessSpinBox">
          <property name="decimals"><number>2</number></property>
          <property name="minimum"><double>0.100000000000000</double></property>
          <property name="maximum"><double>10.000000000000000</double></property>
