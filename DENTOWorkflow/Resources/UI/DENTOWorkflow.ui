          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Permanently remove only the selected DENTOBOT trajectory node after confirmation. The target tooth, segmentation, and target bounds are preserved.</string>
          </property>
          <property name="text">
           <string>Delete Selected Trajectory...</string>
          </property>
         </widget>
        </item>
       </layout>
