   <item>
    <widget class="ctkCollapsibleButton" name="planningCollapsibleButton">
     <property name="text">
      <string>Step 4A — Target Tooth and Trajectory</string>
     </property>
     <property name="collapsed">
      <bool>false</bool>
     </property>
     <layout class="QVBoxLayout" name="planningVerticalLayout">
      <item>
       <widget class="QLabel" name="planningDescriptionLabel">
        <property name="text">
         <string>Select one whole-tooth segment, then place Entry followed by Target in a 2D slice view. Both points must remain inside its target-tooth bounds; coordinates are world RAS millimetres. After the first trajectory is created, the tooth lineage receives one persistent color shared by its Step 4A, 5A, and 5B descendants.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QFormLayout" name="planningInputFormLayout">
        <item row="0" column="0">
         <widget class="QLabel" name="targetToothLabel">
          <property name="text">
           <string>Target tooth:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="targetToothComboBox">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Choose one whole-tooth label from the authoritative segmentation. Pulp, jaw, canal, implant, and other labels are excluded.</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="trajectoryLabel">
          <property name="text">
           <string>Trajectory:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="qMRMLNodeComboBox" name="trajectorySelector">
          <property name="toolTip">
           <string>All loaded trajectory lines remain available here. DENTOBOT trajectories are grouped by target-tooth names and persistent color swatches; selecting a tooth emphasizes its group without retargeting existing trajectories.</string>
          </property>
          <property name="nodeTypes">
           <stringlist notr="true">
            <string>vtkMRMLMarkupsLineNode</string>
           </stringlist>
          </property>
          <property name="showChildNodeTypes">
           <bool>false</bool>
          </property>
          <property name="noneEnabled">
           <bool>true</bool>
          </property>
          <property name="addEnabled">
           <bool>false</bool>
          </property>
          <property name="removeEnabled">
           <bool>false</bool>
          </property>
          <property name="SlicerParameterName" stdset="0">
           <string>trajectoryLine</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QGridLayout" name="planningButtonGridLayout">
        <item row="0" column="0">
         <widget class="QPushButton" name="createTrajectoryButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Create a draft two-point Markups line associated with the selected target tooth.</string>
          </property>
          <property name="text">
           <string>Create New Trajectory</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QPushButton" name="placeTrajectoryButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
         <property name="toolTip">
           <string>Activate the selected two-point Markups line. Press once, then place Entry followed by Target in a slice view. If placement is interrupted after Entry, press again to place Target.</string>
          </property>
          <property name="text">
           <string>Place Both Points</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QPushButton" name="undoTrajectoryPointButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Remove the most recently placed trajectory point. Entry is removed only after Target has already been removed.</string>
          </property>
          <property name="text">
           <string>Undo Last Point</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QPushButton" name="resetTrajectoryButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Clear both Entry and Target after confirmation so the trajectory can be placed again.</string>
          </property>
          <property name="text">
           <string>Clear Both Points</string>
          </property>
         </widget>
        </item>
        <item row="2" column="0" colspan="2">
         <widget class="QPushButton" name="lockTrajectoryButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="checkable">
           <bool>true</bool>
          </property>
          <property name="toolTip">
           <string>Lock a complete valid Entry/Target pair to prevent accidental movement. Uncheck to edit it again.</string>
          </property>
          <property name="text">
           <string>Lock Valid Entry / Target Pair</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0" colspan="2">
         <widget class="QPushButton" name="deleteTrajectoryButton">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string>Permanently remove only the selected DENTOBOT trajectory node after confirmation. The target tooth, segmentation, and target bounds are preserved.</string>
          </property>
          <property name="text">
           <string>Delete Selected Trajectory...</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
