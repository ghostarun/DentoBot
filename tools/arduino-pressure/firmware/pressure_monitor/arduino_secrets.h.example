// Copy to arduino_secrets.h (same folder). Do not commit real credentials.
//
// PRESSURE_WIFI_MODE:
//   0 = WiFi off (USB only)
//   1 = Join a WPA2-PSK network (SECRET_SSID / SECRET_PASS) — not campus LDAP
//   2 = Board is the WiFi access point (AP_SSID / AP_PASS); PC joins the board
//
// IITM "iitmwifi" uses 802.1X PEAP + MSCHAPv2 (LDAP). UNO R4 WiFi cannot join
// that. For wireless monitoring without USB, use MODE 2 and connect the PC WiFi
// to AP_SSID (Ethernet can stay on iitmwifi for internet).
//
#define PRESSURE_WIFI_MODE 2
#define SECRET_SSID "your-wifi-psk-ssid"
#define SECRET_PASS "your-wifi-psk-password"
#define AP_SSID "DENTOBOT-Pressure"
#define AP_PASS "choose-a-strong-password"
#define PRESSURE_TCP_PORT 8765
