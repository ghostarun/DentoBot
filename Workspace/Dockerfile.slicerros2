FROM ghcr.io/rosmed/slicer_ros2_module/ci:jazzy-slicer-v5.10.0

ARG DEBIAN_FRONTEND=noninteractive
ARG MOVEIT_VERSION=2.12.4-1noble.20260615.174305
ARG MOVEIT_OMPL_VERSION=2.12.4-1noble.20260617.150302
ARG XACRO_VERSION=2.1.1-1noble.20260519.011123

# The upstream SlicerROS2 image contains MoveIt core and move_group, but not
# the OMPL pipeline/configuration helpers needed by DENTOBOT plan-only mode.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-jazzy-moveit-configs-utils=${MOVEIT_VERSION} \
        ros-jazzy-moveit-planners-ompl=${MOVEIT_OMPL_VERSION} \
        ros-jazzy-xacro=${XACRO_VERSION} \
    && rm -rf /var/lib/apt/lists/*
