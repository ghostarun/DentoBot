# Copy this file to the workspace root as .dentobot.env and edit the backend
# interpreter for the current workstation. Do not commit the local file.
DENTOBOT_BACKEND_PYTHON=/absolute/path/to/conda/envs/dentobot/bin/python

# Linux Slicer executes the external Linux interpreter directly. The current
# IITM Ubuntu dependency profile is deliberately pinned to CPU inference.
DENTOBOT_BACKEND_EXECUTION_MODE=local
DENTOBOT_BACKEND_DEVICE=cpu

# Intel/AMD Mesa hosts normally use a DRM render node. Identify the correct
# node before changing it; NVIDIA uses a different container GPU contract.
DENTOBOT_RENDER_DEVICE=/dev/dri/renderD128

# This is a path inside the container's workspace data mount.
DENTOBOT_RUN_ARTIFACT_ROOT=/workspace/data/dentobot-runs

# TotalSegmentator remains cache-only during Slicer runs. This directory is
# inside the same mounted data tree and must contain tasks 113, 115, and 298.
DENTOBOT_TOTALSEG_HOME_DIR=/workspace/data/model-cache/totalsegmentator
