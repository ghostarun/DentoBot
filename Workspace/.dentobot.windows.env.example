# Copy this file to the repository root as .dentobot.windows.env and edit it.
# It is read by Workspace/scripts/launch-dentoworkflow.ps1 without executing
# its contents. Keep patient data, credentials, and tokens out of this file.

# Native Windows 3D Slicer executable. DENTOWorkflow itself runs in this
# process; only dependency-heavy inference is delegated to WSL2.
DENTOBOT_SLICER_EXECUTABLE=C:\Program Files\Slicer 5.12.0\Slicer.exe

# Exact name printed by: wsl.exe --list --verbose
DENTOBOT_WSL_DISTRIBUTION=Ubuntu-24.04

# Absolute Linux path inside that WSL distribution. The inference package and
# its pinned CUDA dependencies must be installed in this environment.
DENTOBOT_BACKEND_PYTHON=/home/your-user/miniconda3/envs/dentobot/bin/python

# A local Windows drive path that both Windows Slicer and WSL (/mnt/<drive>)
# can access. Do not select a DICOM source folder or a network/UNC share.
DENTOBOT_RUN_ARTIFACT_ROOT=C:\DENTOBOTRuns

# The validated Windows/WSL profile uses NVIDIA CUDA exposed by the Windows
# driver. Use cpu only with a separately installed and verified CPU stack.
DENTOBOT_BACKEND_DEVICE=cuda:0

# Core planning does not require ROS or Docker. Current SlicerROS2 releases
# target Ubuntu, so the Windows launcher deliberately supports "none" only.
DENTOBOT_ROS_PROFILE=none
