<?xml version="1.0"?>
<package format="3">
  <name>dentobot_moveit_config</name>
  <version>0.1.0</version>
  <description>Simulation-only MoveIt configuration for the DENTOBOT research prototype.</description>
  <maintainer email="taruneswar007@gmail.com">Taruneswar</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>jsoncpp</build_depend>

  <exec_depend>dentobot_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>rclcpp</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <depend>std_msgs</depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
