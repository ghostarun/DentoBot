    <joint name="base_link_to_link-1" type="fixed">
        <!-- Put link-1's thin Y-normal mounting plane parallel to RViz XY and
             orient the articulated chain above the grid. -->
        <origin xyz="0.0 0.0 0.0" rpy="-1.5707963267948966 0.0 0.0" />
        <parent link="base_link" />
        <child link="link-1" />
    </joint>
    <joint name="link-1_Revolute-1" type="revolute">
        <origin xyz="0.0 0.0 0.0" rpy="1.570796326794897 -0.4429645641561608 2.90490637318374e-17" />
        <parent link="link-1" />
        <child link="link-2" />
        <axis xyz="0.0 0.0 1.0" />
        <limit lower="-0.44296456415616081" upper="5.8402204358438388" effort="1000000" velocity="1000000" />
    </joint>
    <joint name="link-2_Slider-2" type="prismatic">
        <!-- J2 zero is the mechanically extended/home end of travel.  The
             former description placed zero at the opposite end.  Moving the
             joint origin to the former q=0.08 pose and reversing the axis
             preserves every physical pose while making q_new=0.08-q_old. -->
        <origin xyz="0.0 0.0 0.0" rpy="-1.5707963267948966 -0.0 1.5707963267948966" />
        <parent link="link-2" />
        <child link="link-3" />
        <axis xyz="0.0 -0.9999999999999999 0.0" />
        <limit lower="0.0" upper="0.08" effort="1000000" velocity="1000000" />
    </joint>
    <joint name="link-3_Revolute-3" type="revolute">
        <origin xyz="-0.047122859999999996 -0.11 -0.09383196" rpy="2.067357736975897 1.101119703255167 -2.067357736975897" />
        <parent link="link-3" />
        <child link="link-4" />
        <axis xyz="0.8936380000000003 -5.639648652959157e-30 0.44878900000000016" />
        <limit lower="-1.0901326507956584" upper="5.1930523492043417" effort="1000000" velocity="1000000" />
    </joint>
    <joint name="link-4_Slider-4" type="prismatic">
        <origin xyz="-0.06702282999999999 0.0 -0.03365918999999999" rpy="-3.141592653589793 2.7755575615628914e-17 5.551115123125784e-17" />
        <parent link="link-4" />
        <child link="link-5" />
        <axis xyz="-0.893638 -2.4694080114073816e-17 0.44878900000000005" />
        <limit lower="0.0" upper="0.075" effort="1000000" velocity="1000000" />
    </joint>
    <!-- Simulation contract: J5 is continuous.  The former finite interval
         [-1.08, 358.92] deg represented one full revolution but forced poses
         just below zero through an almost-complete positive turn. -->
    <joint name="link-5_Revolute-5" type="continuous">
        <origin xyz="-0.021752659999999997 -0.006762529999999991 0.007295090000000003" rpy="-2.933237124130466 -1.553411074346388 2.925952888262058" />
        <parent link="link-5" />
        <child link="pneumatic_spindle-Copy" />
        <axis xyz="-0.38643099999999997 -0.9016699999999997 0.194068" />
        <limit effort="1000000" velocity="1000000" />
    </joint>
    <joint name="pneumatic_spindle-Copy_Revolute-6" type="continuous">
        <origin xyz="0.035401760000000004 0.0029788100000000027 0.04568638" rpy="0.9502765943544816 1.0092142015761 -1.935369066862216" />
        <parent link="pneumatic_spindle-Copy" />
        <child link="burr" />
        <axis xyz="0.40465999999999996 0.432425 -0.805766" />
    </joint>
    <!-- Provisional planning TCP. Its origin is the CAD burr-link origin, not a
         calibrated physical burr tip. +Z is aligned with the spindle axis so
         Step 6 Cartesian poses have an explicit approach-axis convention. -->
    <link name="dentobot_tool_tcp" />
    <joint name="burr_to_dentobot_tool_tcp" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="-2.61089174 -0.36458195 -0.20627347" />
        <parent link="burr" />
        <child link="dentobot_tool_tcp" />
    </joint>
    <!-- CAD-derived provisional drill-tip point. The burr STL spans 7.000 mm
         along dentobot_tool_tcp +Z, so this child marks that distal mesh end.
         It is not a physical TCP calibration and must not be treated as one. -->
    <link name="dentobot_drill_tip_provisional" />
    <joint name="dentobot_tool_tcp_to_drill_tip_provisional" type="fixed">
        <origin xyz="0.0 0.0 0.007" rpy="0.0 0.0 0.0" />
        <parent link="dentobot_tool_tcp" />
        <child link="dentobot_drill_tip_provisional" />
    </joint>
</robot>
